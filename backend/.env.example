# Copy this file to .env and fill in the values.

PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Vector Search works on the free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_resume_analyzer?retryWrites=true&w=majority

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Name of the Atlas Vector Search index on the jobs collection
VECTOR_INDEX_NAME=job_vector_index
